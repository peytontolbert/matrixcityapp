@@ -0,0 +1,27 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Collections.Generic;
+using System.Text.Json;
+
+namespace AssettoServer.Server;
+
+public sealed record MatrixBridgeSettings(string Room, string Revision, string TokenFile, int[] Slots, bool AllowPoseCalibration=false, Dictionary<string,float>? PoseOffsets=null)
+{
+    public static MatrixBridgeSettings? Current { get; } = Load();
+    private static MatrixBridgeSettings? Load()
+    {
+        var path = Environment.GetEnvironmentVariable("MATRIX_ASSETTO_BRIDGE_CONFIG");
+        if (string.IsNullOrWhiteSpace(path)) return null;
+        var result = JsonSerializer.Deserialize<MatrixBridgeSettings>(File.ReadAllText(path),
+            new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? throw new InvalidDataException("Missing bridge configuration");
+        if (result.Room is not ("nohesi-110" or "nohesi-415") || string.IsNullOrWhiteSpace(result.Revision)
+            || result.Revision.Length > 80 || !Path.IsPathFullyQualified(result.TokenFile)
+            || result.Slots is not { Length: > 0 and <= 200 }
+            || result.Slots.Any(s => s < 0 || s > 254)
+            || result.Slots.Distinct().Count() != result.Slots.Length
+            || result.PoseOffsets?.Any(p=>p.Key is not ("06_ygt_53_nissan_350z" or "nohesi_traffic_toyota_prius") || !float.IsFinite(p.Value) || p.Value is <.05f or >2f)==true)
+            throw new InvalidDataException("Invalid Matrix bridge configuration");
+        return result;
+    }
+}
