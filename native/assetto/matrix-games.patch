index 0000000..b4a8f1f
--- /dev/null
+++ b/AssettoServer/Network/Http/MatrixBridgeController.cs
@@ -0,0 +1,28 @@
+using System.Text.Json;
+using System.Threading.Tasks;
+using AssettoServer.Server;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Http;
+
+namespace AssettoServer.Network.Http;
+
+[ApiController]
+public sealed class MatrixBridgeController(MatrixBridge bridge) : ControllerBase
+{
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web) { MaxDepth = 12 };
+    [HttpPost("/_matrix/bridge/v1/exchange")]
+    [RequestSizeLimit(131072)]
+    public async Task<IActionResult> Exchange()
+    {
+        // Never forwarded client identity: this is a loopback-only server-to-server endpoint.
+        if (!bridge.Authorized(HttpContext.Connection.RemoteIpAddress, Request.Headers.Authorization.ToString()))
+            return NotFound();
+        if (!Request.HasJsonContentType()) return BadRequest();
+        MatrixFrame? frame;
+        try { frame = await JsonSerializer.DeserializeAsync<MatrixFrame>(Request.Body, Json, HttpContext.RequestAborted); }
+        catch (JsonException) { return BadRequest(); }
+        if (frame == null) return BadRequest();
+        var snapshot = bridge.Exchange(frame);
+        return snapshot == null ? Conflict() : Content(JsonSerializer.Serialize(snapshot, Json), "application/json");
+    }
+}
