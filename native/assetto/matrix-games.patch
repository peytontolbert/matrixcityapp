@@ -0,0 +1,146 @@
+using System;
+using System.IO;
+using System.Collections.Generic;
+using System.Numerics;
+using System.Reflection;
+using AssettoServer.Network.Tcp;
+using AssettoServer.Server.Weather;
+using System.Linq;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.Extensions.Hosting;
+
+namespace AssettoServer.Server;
+
+public sealed class MatrixBridge(ACServer server, EntryCarManager cars, SessionManager session, WeatherManager weather, CSPServerScriptProvider scripts, CSPClientMessageTypeManager messages) : IHostedService
+{
+    private readonly object _gate = new();
+    private readonly Dictionary<ACTcpClient,(MatrixPhysicsState State,long Time)> _physics = new();
+    private int _impulseSequence;
+    private long _scoreTime;
+    private long _physicsDiagnosticTime;
+    private readonly Dictionary<string,float> _poseOffsets=new();
+    private readonly Dictionary<ACTcpClient,long> _calibrationTime=new();
+    private bool Coupled(ACTcpClient client,long now) => _physics.TryGetValue(client,out var p) && p.State.Ready && p.State.Ack>0 && now-p.Time<500;
+    private float[]? Feet(ACTcpClient client,long now) => _physics.TryGetValue(client,out var p) && p.State.Offset>.05 && now-p.Time<500 ? [p.State.Feet.X,p.State.Feet.Y,p.State.Feet.Z] : null;
+    private Vector3 Velocity(ACTcpClient client,long now) => _physics.TryGetValue(client,out var p)&&now-p.Time<500?p.State.Velocity:client.EntryCar.Status.Velocity;
+    private void OnPhysics(ACTcpClient client,MatrixPhysicsState state)
+    {
+        if(!float.IsFinite(state.Velocity.X+state.Velocity.Y+state.Velocity.Z)||state.Velocity.Length()>200)return;
+        if(client.MatrixAccountId == null || !client.HasSentFirstUpdate || !float.IsFinite(state.Offset) || state.Offset is <0 or >2 || !float.IsFinite(state.Feet.X+state.Feet.Y+state.Feet.Z))return;
+        var poseDistance=Vector3.Distance(state.Feet,client.EntryCar.Status.Position);
+        if(poseDistance>5){var time=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();if(time-_physicsDiagnosticTime>5000){_physicsDiagnosticTime=time;Serilog.Log.Warning("Matrix companion pose rejected distance={Distance} speed={Speed}",poseDistance,state.Velocity.Length());}return;}
+        lock(_gate){var now=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();if(_physics.TryGetValue(client,out var previous)&&now-previous.Time<70)return;if(previous.State==null)Serilog.Log.Information("Matrix physics report ready={Ready} offset={Offset}",state.Ready,state.Offset);_physics[client]=(state,now);}
+    }
+    private MatrixFrameGate? _validator;
+    private byte[]? _tokenHash;
+    private MatrixFrame? _pending;
+    private readonly Dictionary<(byte Slot,string Account),(Vector3 Delta,Vector3 TargetVelocity,long Time)> _pendingImpacts=new();
+    private long _lastFrame;
+    private long _applied;
+    private MatrixSnapshot? _snapshot;
+
+    public bool Authorized(IPAddress? address, string header)
+    {
+        if (_tokenHash == null || address == null || !(IPAddress.IsLoopback(address) || (address.IsIPv4MappedToIPv6 && IPAddress.IsLoopback(address.MapToIPv4())))
+            || !header.StartsWith("Bearer ", StringComparison.Ordinal) || header.Length > 256) return false;
+        return CryptographicOperations.FixedTimeEquals(_tokenHash, SHA256.HashData(Encoding.UTF8.GetBytes(header[7..])));
+    }
+
+    public MatrixSnapshot? Exchange(MatrixFrame frame)
+    {
+        lock (_gate)
+        {
+            if (_validator == null || !_validator.Accept(frame, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds())) return null;
+            _pending = frame;
+            foreach(var impact in frame.Impacts??[]){var key=(impact.Slot,impact.Account);var delta=new Vector3(impact.Delta[0],impact.Delta[1],impact.Delta[2]);var target=new Vector3(impact.TargetVelocity[0],impact.TargetVelocity[1],impact.TargetVelocity[2]);_pendingImpacts[key]=(delta,target,frame.IssuedAt);}
+            return _snapshot;
+        }
+    }
+
+    public Task StartAsync(CancellationToken cancellationToken)
+    {
+        var settings = MatrixBridgeSettings.Current;
+        if (settings == null) return Task.CompletedTask;
+        if (settings.Slots.Any(s => s >= cars.EntryCars.Length || cars.EntryCars[s].AiControlled))
+            throw new InvalidDataException("Matrix bridge requires exclusive non-AI slots in the entry list");
+        var token = File.ReadAllText(settings.TokenFile).Trim();
+        if (token.Length < 43 || token.Length > 128) throw new InvalidDataException("Matrix bridge requires a strong private token");
+        _tokenHash = SHA256.HashData(Encoding.UTF8.GetBytes(token));
+        MatrixNativeAdmission.Current = new MatrixNativeAdmission(settings.Room,token);
+        _validator = new MatrixFrameGate(settings.Room, settings.Revision, settings.Slots);
+        _snapshot = new MatrixSnapshot(1, settings.Room, settings.Revision, 0, 0, []);
+        foreach(var pair in settings.PoseOffsets??new())_poseOffsets[pair.Key]=pair.Value;
+        messages.RegisterOnlineEvent<MatrixPhysicsState>(OnPhysics);
+        messages.RegisterOnlineEvent<MatrixPoseCalibration>((client,p)=>{
+            // Calibration is an isolated staging tool, never a player's global
+            // model-height control in production. Release offsets are operator pinned.
+            if(!settings.AllowPoseCalibration||client.MatrixAccountId==null||p.Slot>=cars.EntryCars.Length||!settings.Slots.Contains(p.Slot)||!float.IsFinite(p.Offset)||p.Offset is <.05f or >2f)return;
+            lock(_gate){var now=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();if(_calibrationTime.TryGetValue(client,out var last)&&now-last<200)return;_calibrationTime[client]=now;_poseOffsets[cars.EntryCars[p.Slot].Model]=p.Offset;}
+        });
+        // Consume spoofed client impulses; never relay them to other clients.
+        messages.RegisterOnlineEvent<MatrixPhysicsImpulse>((_,_)=>{});
+        messages.RegisterOnlineEvent<MatrixDrivingScore>((_,_)=>{});
+        using var lua=new StreamReader(Assembly.GetExecutingAssembly().GetManifestResourceStream("AssettoServer.Server.Lua.matrix_physics.lua")!);
+        scripts.AddScript(lua.ReadToEnd().Replace("__MATRIX_SLOTS__","{"+string.Join(",",settings.Slots)+"}").Replace("__MATRIX_CALIBRATION__",settings.AllowPoseCalibration?"true":"false"),configuration:new Dictionary<string,object>{{"REQUIRED",1}});
+        using var hud=new StreamReader(Assembly.GetExecutingAssembly().GetManifestResourceStream("AssettoServer.Server.Lua.matrix_hud.lua")!);
+        scripts.AddScript(hud.ReadToEnd(),configuration:new Dictionary<string,object>{{"REQUIRED",1}});
+        server.Update += Tick;
+        return Task.CompletedTask;
+    }
+
+    private void Tick(ACServer sender, EventArgs args)
+    {
+        var settings = MatrixBridgeSettings.Current!;
+        MatrixFrame? frame;
+        Dictionary<(byte Slot,string Account),(Vector3 Delta,Vector3 TargetVelocity,long Time)> impacts;
+        lock (_gate) { frame = _pending; _pending = null;impacts=new(_pendingImpacts);_pendingImpacts.Clear(); }
+        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+        if (frame != null)
+        {
+            if(now-_scoreTime>=500){_scoreTime=now;foreach(var score in frame.Scores??[]){if(score.Slot>=cars.EntryCars.Length)continue;var client=cars.EntryCars[score.Slot].Client;if(client?.MatrixAccountId!=score.Account)continue;var rows=score.Leaders;client.SendPacket(new MatrixDrivingScore{Score=score.Score,Combo=score.Combo,Passes=score.Passes,Rank=score.Rank,First=rows.ElementAtOrDefault(0)?.Driver??"",FirstScore=rows.ElementAtOrDefault(0)?.Score??0,Second=rows.ElementAtOrDefault(1)?.Driver??"",SecondScore=rows.ElementAtOrDefault(1)?.Score??0,Third=rows.ElementAtOrDefault(2)?.Driver??"",ThirdScore=rows.ElementAtOrDefault(2)?.Score??0});}}
+            lock(_gate){
+                foreach(var client in _physics.Keys.Where(c=>c.EntryCar.Client!=c).ToArray())_physics.Remove(client);
+                foreach(var client in _calibrationTime.Keys.Where(c=>c.EntryCar.Client!=c).ToArray())_calibrationTime.Remove(client);
+                foreach(var car in cars.EntryCars.Where(c=>c.Client!=null&&!c.ExternalReserved)){
+                    var client=car.Client!;if(!_physics.TryGetValue(client,out var state)||!state.State.Ready||now-state.Time>=500)continue;
+                    var hasImpact=client.MatrixAccountId!=null&&impacts.TryGetValue((car.SessionId,client.MatrixAccountId),out var impact)&&now-impact.Time<500;
+                    var delta=hasImpact?impacts[(car.SessionId,client.MatrixAccountId!)].Delta:Vector3.Zero;
+                    client.SendPacket(new MatrixPhysicsImpulse{Sequence=++_impulseSequence,Delta=delta,TargetVelocity=hasImpact?impacts[(car.SessionId,client.MatrixAccountId!)].TargetVelocity:state.State.Velocity});
+                }
+            }
+            var active = frame.Vehicles.Select(v => (int)v.Slot).ToHashSet();
+            foreach (var slot in settings.Slots) if (!active.Contains(slot)) cars.EntryCars[slot].ClearExternal();
+            foreach (var vehicle in frame.Vehicles) cars.EntryCars[vehicle.Slot].SetExternal(vehicle, session.ServerTimeMilliseconds);
+            _lastFrame = now;
+            _applied = frame.Sequence;
+        }
+        else if (now - _lastFrame >= MatrixFrameGate.LeaseMilliseconds)
+            foreach (var slot in settings.Slots) cars.EntryCars[slot].ClearExternal();
+        // Account UUID is private admission bookkeeping; the public broker snapshot strips it.
+        // Steam IDs, IPs, chat and authentication material never cross the relay.
+        lock(_gate){
+        var native = cars.EntryCars.Where(c => c.Client is { HasSentFirstUpdate: true } && !c.ExternalReserved)
+            .Select(c => new MatrixNativeVehicle(c.SessionId, c.Model, $"Driver {c.SessionId + 1}",
+                [c.Status.Position.X, c.Status.Position.Y, c.Status.Position.Z],
