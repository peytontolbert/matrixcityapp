+-- Session-only Matrix Games HUD. F7 restores the user's normal HUD immediately.
+local enabled=true
+local score,age={score=0,combo=1,passes=0,rank=0},100
+local hudText=rgbm(.91,.95,.96,1)
+local accent=rgbm(.75,.95,.4,1)
+ac.OnlineEvent({ac.StructItem.key('MG_DrivingScore_v1'),score=ac.StructItem.int32(),combo=ac.StructItem.float(),passes=ac.StructItem.int32(),rank=ac.StructItem.int32(),first=ac.StructItem.string(20),firstScore=ac.StructItem.int32(),second=ac.StructItem.string(20),secondScore=ac.StructItem.int32(),third=ac.StructItem.string(20),thirdScore=ac.StructItem.int32()},function(sender,data)
+  if sender~=nil then return end
+  score={score=data.score,combo=data.combo,passes=data.passes,rank=data.rank,first=data.first,firstScore=data.firstScore,second=data.second,secondScore=data.secondScore,third=data.third,thirdScore=data.thirdScore};age=0
+end)
+function script.update(dt) age=age+dt end
+local function text(value,size,x,y,color)ui.dwriteDrawText(tostring(value),size,vec2(x,y),color or hudText)end
+local function draw()
+ local car=ac.getCar(0);local size=ac.getUI().windowSize
+ local x,y=size.x-150,size.y-165
+ ui.drawCircleFilled(vec2(x,y),110,rgbm(.025,.045,.055,.92),64)
+ local rpm=math.max(0,math.min(1,car.rpm/math.max(1000,car.rpmLimiter)))
+ for i=0,47 do local angle=(135+i*270/47)*math.pi/180;local active=i/47<=rpm;local color=active and (i>40 and rgbm(1,.32,.25,1) or accent) or rgbm(.18,.23,.26,1)
+  ui.drawLine(vec2(x+math.cos(angle)*94,y+math.sin(angle)*94),vec2(x+math.cos(angle)*103,y+math.sin(angle)*103),color,4)
+ end
+ local speed=math.floor(car.speedKmh+.5);text(speed,48,x-48,y-49);text('KM/H',13,x-21,y+2)
+ text(car.gear<0 and 'R' or car.gear==0 and 'N' or tostring(car.gear),35,x-11,y+20,accent)
+ text(math.floor(car.rpm)..' RPM',12,x-34,y+65)
+ text('MATRIX / DRIVE',13,32,30,accent)
+ text(string.format('%d   x%.1f',score.score,score.combo),28,32,55)
+ text('CLEAN PASSES  '..score.passes..'   RANK  '..(score.rank>0 and score.rank or '--'),13,32,94)
+ text(age<3 and 'ROOM BEST' or 'SCORE UPDATES UNAVAILABLE',12,32,132,accent)
+ for i,key in ipairs({'first','second','third'})do if score[key] and score[key]~='' then text(i..'  '..score[key]..'   '..score[key..'Score'],15,32,142+i*24) end end
+ text('F7  Toggle Matrix HUD',12,size.x-238,size.y-35)
+end
+local hud=ui.onExclusiveHUD(function(mode)
+ if ui.keyPressed(ui.KeyIndex.F7) then enabled=not enabled end
+ if mode~='game' or not enabled then return end
+ -- Preserve CSP apps, including ComfyMap and its teleport controls.
+ draw();return 'apps'
+end)
+function script.release()hud:dispose()end
diff --git a/AssettoServer/Server/Lua/matrix_physics.lua b/AssettoServer/Server/Lua/matrix_physics.lua
new file mode 100644
index 0000000..f9549c6
--- /dev/null
+++ b/AssettoServer/Server/Lua/matrix_physics.lua
@@ -0,0 +1,90 @@
+-- Matrix Games: server-authoritative contacts with external vehicles only.
+-- Native/native and native/track collision solvers remain in Assetto Corsa.
+local slots = __MATRIX_SLOTS__
+local elapsed, nextReport, lease, sequence = 0, 0, -10, 0
+local reportedSend=false
+local offset = nil
+local collided=false
+local bySession, collisionStates={},{}
+local function carBySession(slot)return bySession[slot]end
+local calibrationAt,calibrationIndex,nextIndex,diagnosticAt=0,1,0,0
+local modelGround={['06_ygt_53_nissan_350z']=.25743,['nohesi_traffic_toyota_prius']=.50341796875}
+local calibrationEnabled=__MATRIX_CALIBRATION__
+local calibrationLogged={}
+local sendCalibration=ac.OnlineEvent({ac.StructItem.key('MG_PoseCalibration_v1'),slot=ac.StructItem.byte(),offset=ac.StructItem.float()},function() end)
+local sendState = ac.OnlineEvent({ac.StructItem.key('MG_PhysicsState_v2'),
+  ready=ac.StructItem.boolean(), feet=ac.StructItem.vec3(), velocity=ac.StructItem.vec3(), offset=ac.StructItem.float(), ack=ac.StructItem.int32(),collision=ac.StructItem.boolean()}, function() end)
+local enabled = physics.allowed() and ac.getPatchVersionCode() >= 3424
+ac.log('[Matrix physics] loaded; physics permission='..tostring(enabled))
+ac.OnlineEvent({ac.StructItem.key('MG_PhysicsImpulse_v2'), sequence=ac.StructItem.int32(), delta=ac.StructItem.vec3(), targetVelocity=ac.StructItem.vec3()}, function(sender, data)
+  if sender ~= nil or not enabled or data.sequence <= sequence then return end
+  local d,t=data.delta,data.targetVelocity
+  if not t or d.x~=d.x or d.y~=d.y or d.z~=d.z or d:length()>80 or math.abs(d.y)>.001 then return end
+  if t.x~=t.x or t.y~=t.y or t.z~=t.z or math.abs(t.x)>200 or math.abs(t.y)>200 or math.abs(t.z)>200 then return end
+  if sequence==0 then ac.log('[Matrix physics] server lease acknowledged') end
+  sequence=data.sequence; lease=elapsed
+  if d:lengthSquared()>.000001 then
+    -- Delayed/repeated reports must not add the same collision impulse again.
+    -- Correct only toward the solver's target along the contact direction;
+    -- preserve suspension velocity and cap any single correction at 8 m/s.
+    local n=d*(1/d:length());n.y=0
+    local current=ac.getCar(0).velocity
+    local change=math.min(8,d:length(),math.max(0,(t-current):dot(n)))
+    if change>.001 then physics.setCarVelocity(0,current+n*change);ac.log('[Matrix physics] bounded contact '..sequence..' dv='..change) end
+  end
+end)
+local function collisions(disable)
+  for _,slot in ipairs(slots) do
+    local car=carBySession(slot)
+    if car and car.index~=0 and collisionStates[car.index]~=disable then physics.disableCarCollisions(car.index,disable,true);collisionStates[car.index]=disable end
+  end
+end
+function script.update(dt)
+  elapsed=elapsed+dt
+  -- Session slots change at network cadence, not render cadence.
+  if elapsed>=nextIndex then
+    nextIndex=elapsed+.1
+    for k in pairs(bySession) do bySession[k]=nil end
+    for i=0,ac.getSim().carsCount-1 do local c=ac.getCar(i);if c.isConnected~=false then bySession[c.sessionID]=c else collisionStates[i]=nil end end
+  end
+  local car=ac.getCar(0)
+  collided=collided or (car.collisionDepth or 0)>.001
+  local total,count=0,0
+  for i=0,3 do local w=car.wheels[i]
+    if w.load>10 then total=total+(car.position-w.contactPoint):dot(car.up);count=count+1 end
+  end
+  if count==4 then local measured=total/count;if measured>.05 and measured<2 then if not offset then ac.log('[Matrix physics] grounded offset='..measured) end;offset=measured end end
+  if calibrationEnabled and #slots>0 and elapsed>=calibrationAt then
+    calibrationAt=elapsed+.5;local slot=slots[calibrationIndex];calibrationIndex=calibrationIndex%#slots+1
+    local remote=carBySession(slot)
+    if remote and modelGround[remote:id()] then
+      -- Network poses are physics origins. Measure to actual tyre bottoms;
+      -- adding the exported mesh lift to the body transform double-counted lift.
+      local lift,bottom,count=0,0,0
+      for i=0,3 do local w=remote.wheels[i];local r=w.tyreRadius or 0
+        if w.position and r>.1 and r<1 then
+          lift=lift+(remote.transform.position-w.position):dot(remote.up)+r
+          bottom=bottom+w.position.y-r;count=count+1
+        end
+      end
+      if count==4 then
+        lift=lift/count
+        if lift>.05 and lift<2 then sendCalibration({slot=slot,offset=lift},false,255) end
+        ac.log('[Matrix pose] '..remote:id()..' lift='..lift..' tyreBottom='..bottom/count)
+      end
+    end
+  end
+  if calibrationEnabled and elapsed>=diagnosticAt then
+    diagnosticAt=elapsed+5;local sim=ac.getSim()
+    ac.log('[Matrix performance] fps='..tostring(sim.fps)..' cpuTime='..tostring(sim.cpuTime)..' physicsLate='..tostring(sim.physicsLate))
+  end
+  local ready=enabled and offset~=nil
+  -- A dropped server lease restores the native colliders automatically.
+  if enabled then collisions(ready and elapsed-lease<.75) end
+  if elapsed>=nextReport then
+    nextReport=elapsed+.1
+    local sent=sendState({ready=ready,feet=car.position-car.up*(offset or 0),offset=offset or 0,velocity=car.velocity,ack=sequence,collision=collided},false,255);collided=false
+    if not reportedSend then reportedSend=true;ac.log('[Matrix physics] state sent='..tostring(sent)..' direct='..tostring(ac.getSim().directMessagingAvailable)) end
+  end
+end
+function script.release() if enabled then collisions(false) end end
diff --git a/AssettoServer/Server/MatrixBridge.cs b/AssettoServer/Server/MatrixBridge.cs
