diff --git a/AssettoServer.Tests/MatrixBridgeTests.cs b/AssettoServer.Tests/MatrixBridgeTests.cs
new file mode 100644
index 0000000..5f6587c
--- /dev/null
+++ b/AssettoServer.Tests/MatrixBridgeTests.cs
@@ -0,0 +1,89 @@
+using AssettoServer.Server;
+using NUnit.Framework;
+using System.Text.Json;
+
+namespace AssettoServer.Tests;
+
+public class MatrixBridgeTests
+{
+    [Test] public void ConfigurationAcceptsNumericSlotArray()
+    {
+        var settings=JsonSerializer.Deserialize<MatrixBridgeSettings>(
+            "{\"room\":\"nohesi-110\",\"revision\":\"test-r1\",\"tokenFile\":\"/private/bridge.token\",\"slots\":[4,5,15]}",
+            new JsonSerializerOptions(JsonSerializerDefaults.Web));
+        Assert.That(settings!.Slots,Is.EqualTo(new[]{4,5,15}));
+        Assert.That(new MatrixFrameGate(settings.Room,settings.Revision,settings.Slots)
+            .Accept(Frame() with {Vehicles=[Frame().Vehicles[0] with {Slot=4}]},Now),Is.True);
+    }
+    private const long Now = 10000;
+    private static MatrixFrame Frame() => new(1, "nohesi-110", "test-r1", Guid.NewGuid().ToString(), 1, Now,
+        [new MatrixVehicle(16, "browser:one", "Browser driver", [1,2,3], [0,0,0], [0,0,0])]);
+    private static MatrixFrameGate Gate() => new("nohesi-110", "test-r1", [16,17]);
+
+    [Test] public void AcceptsValidFrame() => Assert.That(Gate().Accept(Frame(), Now), Is.True);
+    [Test] public void ScoreFramesRejectSpoofedSlotsAndUnboundedData()
+    {
+        var score=new MatrixScore(0,Guid.NewGuid().ToString(),100,1,1,1,[new MatrixLeader(1,"Driver ABCDEF",100,1)]);
+        Assert.That(Gate().Accept(Frame() with {Scores=[score]},Now),Is.True);
+        Assert.That(Gate().Accept(Frame() with {Scores=[score with {Slot=16}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Scores=[score with {Combo=float.NaN}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Scores=[score,score]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Scores=[score with {Leaders=[new MatrixLeader(1,"<script>",100,1)]}]},Now),Is.False);
+    }
+    [Test] public void CoupledImpactsRequireAccountAndNativeSlot()
+    {
+        var impact=new MatrixImpact(0,Guid.NewGuid().ToString(),[2,0,-1],[20,0,0]);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact]},Now),Is.True);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact with {Slot=16}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact with {TargetVelocity=[float.NaN,0,0]}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact with {Delta=[0,1,0]}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact with {Account="anonymous"}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact,impact]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact with {Delta=[80,80,80]}]},Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with {Impacts=[impact with {Delta=[float.NaN,0,0]}]},Now),Is.False);
+    }
+    [Test] public void DeniesNativeSlotInjection()
+    {
+        var f=Frame(); Assert.That(Gate().Accept(f with { Vehicles=[f.Vehicles[0] with { Slot=0 }] }, Now), Is.False);
+    }
+    [Test] public void DeniesDuplicateSlots()
+    {
+        var f=Frame(); Assert.That(Gate().Accept(f with { Vehicles=[f.Vehicles[0], f.Vehicles[0] with {Entity="browser:two"}] }, Now), Is.False);
+    }
+    [Test] public void DeniesDuplicateEntities()
+    {
+        var f=Frame(); Assert.That(Gate().Accept(f with { Vehicles=[f.Vehicles[0], f.Vehicles[0] with {Slot=17}] }, Now), Is.False);
+    }
+    [TestCase("nohesi-415", "test-r1")]
+    [TestCase("nohesi-110", "wrong")]
+    public void DeniesOtherWorld(string room, string revision) =>
+        Assert.That(Gate().Accept(Frame() with { Room=room, Revision=revision }, Now), Is.False);
+    [Test] public void DeniesNonFinitePose()
+    {
+        var f=Frame(); Assert.That(Gate().Accept(f with { Vehicles=[f.Vehicles[0] with { Position=[float.NaN,0,0] }] }, Now), Is.False);
+    }
+    [Test] public void DeniesReplay()
+    {
+        var gate=Gate(); var f=Frame(); Assert.That(gate.Accept(f,Now),Is.True);
+        Assert.That(gate.Accept(f,Now+100),Is.False);
+    }
+    [Test] public void DeniesStaleAndFutureFrames()
+    {
+        Assert.That(Gate().Accept(Frame() with { IssuedAt=Now-2001 },Now),Is.False);
+        Assert.That(Gate().Accept(Frame() with { IssuedAt=Now+1001 },Now),Is.False);
+    }
+    [Test] public void OwnerCannotBeReplacedUntilLeaseExpires()
+    {
+        var gate=Gate(); Assert.That(gate.Accept(Frame(),Now),Is.True);
+        Assert.That(gate.Accept(Frame() with { IssuedAt=Now+100 },Now+100),Is.False);
+        Assert.That(gate.Accept(Frame() with { IssuedAt=Now+3000 },Now+3000),Is.True);
+    }
+    [Test] public void RateLimitDoesNotBlockNextValidFrame()
+    {
+        var gate=Gate(); var f=Frame(); Assert.That(gate.Accept(f,Now),Is.True);
+        Assert.That(gate.Accept(f with {Sequence=2},Now+1),Is.False);
+        Assert.That(gate.Accept(f with {Sequence=2},Now+50),Is.True);
+    }
+    [Test] public void EmptySnapshotRemovesAllExternalCars() =>
+        Assert.That(Gate().Accept(Frame() with { Vehicles=[] },Now),Is.True);
+}
