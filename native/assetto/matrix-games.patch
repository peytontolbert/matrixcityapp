new file mode 100644
index 0000000..62a42dc
--- /dev/null
+++ b/AssettoServer.Tests/MatrixNativeAdmissionTests.cs
@@ -0,0 +1,32 @@
+using System;
+using System.Security.Cryptography;
+using System.Text;
+using AssettoServer.Server;
+using NUnit.Framework;
+namespace AssettoServer.Tests;
+public class MatrixNativeAdmissionTests
+{
+    const string Actor="11111111-1111-4111-8111-111111111111",Key="test-only-native-admission-key",Model="06_ygt_53_nissan_350z";
+    const ulong Steam=76561198000000000;
+    static string Url(byte[] v)=>Convert.ToBase64String(v).TrimEnd('=').Replace('+','-').Replace('/','_');
+    static string Ticket(string nonce="aaaaaaaaaaaaaaaa",long expires=190,string room="nohesi-110"){
+        var payload=Url(Encoding.UTF8.GetBytes(Actor+"|"+Steam+"|"+expires+"|"+nonce));
+        return "mg1."+payload+"."+Url(HMACSHA256.HashData(Encoding.UTF8.GetBytes(Key),Encoding.UTF8.GetBytes(room+"|"+payload)));
+    }
+    [Test] public void AcceptsOnceAndReservesAccountUntilDisconnect(){
+        var gate=new MatrixNativeAdmission("nohesi-110",Key);
+        Assert.That(gate.Accept(Steam,Model,Ticket(),100,out var actor),Is.True);Assert.That(actor,Is.EqualTo(Actor));
+        Assert.That(gate.Accept(Steam,Model,Ticket(),100,out _),Is.False);
+        Assert.That(gate.Accept(Steam,Model,Ticket("bbbbbbbbbbbbbbbb"),100,out _),Is.False);
+        gate.Release(Actor);Assert.That(gate.Accept(Steam,Model,Ticket("bbbbbbbbbbbbbbbb"),100,out _),Is.True);
+    }
+    [Test] public void RejectsAnonymousWrongSteamWrongRoomExpiryAndTampering(){
+        var gate=new MatrixNativeAdmission("nohesi-110",Key);
+        Assert.That(gate.Accept(Steam,Model,"",100,out _),Is.False);
+        Assert.That(gate.Accept(Steam+1,Model,Ticket(),100,out _),Is.False);
+        Assert.That(gate.Accept(Steam,Model,Ticket(room:"nohesi-415"),100,out _),Is.False);
+        Assert.That(gate.Accept(Steam,Model,Ticket(expires:99),100,out _),Is.False);
+        Assert.That(gate.Accept(Steam,Model,Ticket()+"x",100,out _),Is.False);
+        Assert.That(gate.Accept(Steam,"other-car",Ticket(),100,out _),Is.False);
+    }
+}
