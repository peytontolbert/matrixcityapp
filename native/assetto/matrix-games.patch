diff --git a/AssettoServer/Server/EntryCarMatrix.cs b/AssettoServer/Server/EntryCarMatrix.cs
new file mode 100644
index 0000000..c2ebfa9
--- /dev/null
+++ b/AssettoServer/Server/EntryCarMatrix.cs
@@ -0,0 +1,55 @@
+using System;
+using System.Linq;
+using System.Numerics;
+using AssettoServer.Shared.Model;
+using AssettoServer.Shared.Network.Packets.Outgoing;
+
+namespace AssettoServer.Server;
+
+public partial class EntryCar
+{
+    // Reserved even while inactive: an administrator/native SLOT_INDEX join must not steal it.
+    public bool ExternalReserved => MatrixBridgeSettings.Current?.Slots.Contains(SessionId) == true;
+    public bool ExternalActive { get; private set; }
+    public string? ExternalName { get; private set; }
+    private string? _externalEntity;
+
+    internal void SetExternal(MatrixVehicle vehicle, long now)
+    {
+        if (!ExternalReserved || Client != null || AiControlled) throw new InvalidOperationException("External slot is not exclusive");
+        if (ExternalActive && _externalEntity != vehicle.Entity) ClearExternal();
+        // Publish a complete pose before advertising the car to native clients.
+        var status = new CarStatus
+        {
+            Position = new Vector3(vehicle.Position[0], vehicle.Position[1], vehicle.Position[2]),
+            Rotation = new Vector3(vehicle.Rotation[0], vehicle.Rotation[1], vehicle.Rotation[2]),
+            Velocity = new Vector3(vehicle.Velocity[0], vehicle.Velocity[1], vehicle.Velocity[2]),
+            Timestamp = now, PakSequenceId = unchecked((byte)(Status.PakSequenceId + 1)),
+            EngineRpm = vehicle.Rpm, Gear = vehicle.Gear, Gas = vehicle.Gas, SteerAngle = vehicle.Steer,
+            StatusFlag = (vehicle.Brake ? CarStatusFlags.BrakeLightsOn : 0) | (vehicle.Lights ? CarStatusFlags.LightsOn : 0)
+        };
+        Status = status;
+        HasUpdateToSend = true;
+        _externalEntity = vehicle.Entity;
+        ExternalName = vehicle.Name;
+        if (_sessionManager.CurrentSession.Results?.TryGetValue(SessionId, out var result) == true)
+            result.Name = vehicle.Name;
+        if (!ExternalActive)
+        {
+            ExternalActive = true;
+            _entryCarManager.BroadcastPacket(new CarConnected { SessionId = SessionId, Name = ExternalName, Nation = "" });
+        }
+    }
+
+    internal void ClearExternal()
+    {
+        if (!ExternalActive) return;
+        ExternalActive = false;
+        ExternalName = null;
+        _externalEntity = null;
+        HasUpdateToSend = false;
+        _entryCarManager.BroadcastPacket(new CarDisconnected { SessionId = SessionId });
+        if (_sessionManager.CurrentSession.Results?.TryGetValue(SessionId, out var result) == true) result.Name = "";
+        Reset();
+    }
+}
