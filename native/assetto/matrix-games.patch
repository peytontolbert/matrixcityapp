diff --git a/AssettoServer/Server/MatrixBridgeProtocol.cs b/AssettoServer/Server/MatrixBridgeProtocol.cs
new file mode 100644
index 0000000..a82a405
--- /dev/null
+++ b/AssettoServer/Server/MatrixBridgeProtocol.cs
@@ -0,0 +1,74 @@
+// Matrix Games external vehicles. Native Steam authentication is unchanged.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace AssettoServer.Server;
+
+public sealed record MatrixVehicle(byte Slot, string Entity, string Name,
+    float[] Position, float[] Rotation, float[] Velocity, ushort Rpm = 800,
+    byte Gear = 1, byte Gas = 0, byte Steer = 127, bool Brake = false, bool Lights = false);
+public sealed record MatrixFrame(int Schema, string Room, string Revision, string Stream,
+    long Sequence, long IssuedAt, MatrixVehicle[] Vehicles, MatrixImpact[]? Impacts = null, MatrixScore[]? Scores = null);
+public sealed record MatrixLeader(int Rank,string Driver,int Score,int Passes);
+public sealed record MatrixScore(byte Slot,string Account,int Score,float Combo,int Passes,int Rank,MatrixLeader[] Leaders);
+public sealed record MatrixImpact(byte Slot, string Account, float[] Delta, float[] TargetVelocity);
+public sealed record MatrixNativeVehicle(byte Slot, string Model, string Name,
+    float[] Position, float[] Rotation, float[] Velocity, string? Account = null,
+    ushort Rpm = 800, byte Gear = 1, byte Gas = 0, byte Steer = 127, bool Brake = false, bool Lights = false, bool Coupled = false, float[]? Feet = null,bool Collision=false,long PhysicsTime=0);
+public sealed record MatrixEnvironment(float Hour,float Rain,float Wetness,float Water,float Cloud,float Grip,float Wind,int WindDirection,float Temperature,int DayOfYear=172,float Latitude=34.05f);
+public sealed record MatrixSnapshot(int Schema, string Room, string Revision, long AppliedSequence,
+    long ServerTime, MatrixNativeVehicle[] Vehicles, MatrixEnvironment? Environment = null, Dictionary<string,float>? PoseOffsets = null);
+
+/// <summary>One authenticated relay owns a complete, bounded external-vehicle set.</summary>
+public sealed class MatrixFrameGate(string room, string revision, IEnumerable<int> slots)
+{
+    private readonly HashSet<int> _slots = slots.ToHashSet();
+    private string? _stream;
+    private long _sequence;
+    private long _lastAccepted;
+    private long _lastIssued;
+    public const int LeaseMilliseconds = 3000;
+
+    public bool Accept(MatrixFrame frame, long now)
+    {
+        if (frame.Schema != 1 || frame.Room != room || frame.Revision != revision
+            || !Guid.TryParseExact(frame.Stream, "D", out _) || frame.Sequence < 1
+            || frame.IssuedAt < now - 2000 || frame.IssuedAt > now + 1000
+            || frame.Vehicles == null || frame.Vehicles.Length > _slots.Count) return false;
+        if(frame.Impacts is {Length: > 32})return false;
+        var impacted = new HashSet<byte>();
+        foreach(var impact in frame.Impacts ?? [])
+            if(impact == null || _slots.Contains(impact.Slot) || !impacted.Add(impact.Slot) || !Guid.TryParse(impact.Account,out _) || !Vector(impact.Delta,80) || impact.Delta.Sum(x=>x*x)>6400 || MathF.Abs(impact.Delta[1])>.001f || !Vector(impact.TargetVelocity,200))return false;
+        var seen = new HashSet<byte>();
+        var scored=new HashSet<byte>();
+        if(frame.Scores is {Length:>32})return false;
+        foreach(var score in frame.Scores??[])
+            if(score==null||_slots.Contains(score.Slot)||!scored.Add(score.Slot)||!Guid.TryParse(score.Account,out _)||score.Score<0||score.Passes<0||!float.IsFinite(score.Combo)||score.Combo is <1 or >5||score.Rank is <0 or >10||score.Leaders==null||score.Leaders.Length>3||score.Leaders.Any(l=>l==null||l.Score<0||l.Driver==null||l.Driver.Length>20||l.Driver.Any(c=>!char.IsAsciiLetterOrDigit(c)&&c!=' ')))return false;
+        var entities = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var car in frame.Vehicles)
+        {
+            if (car == null || !_slots.Contains(car.Slot) || !seen.Add(car.Slot)
+                || string.IsNullOrEmpty(car.Entity) || car.Entity.Length > 96 || !entities.Add(car.Entity)
+                || car.Entity.Any(c => !char.IsAsciiLetterOrDigit(c) && c is not '-' and not '_' and not ':')
+                || string.IsNullOrWhiteSpace(car.Name) || car.Name.Length > 48 || car.Name.Any(char.IsControl)
+                || !Vector(car.Position, 100000) || !Vector(car.Rotation, 4 * MathF.PI)
+                || !Vector(car.Velocity, 200) || car.Gear > 15) return false;
+        }
+        if (_stream == frame.Stream)
+        {
+            if (frame.Sequence <= _sequence || frame.IssuedAt < _lastIssued) return false;
+        }
+        else if (_stream != null && now - _lastAccepted < LeaseMilliseconds) return false;
+        // Maximum 40 accepted frames/sec; malformed or replayed frames never renew a lease.
+        if (_stream != null && now - _lastAccepted < 25) return false;
+        _stream = frame.Stream;
+        _sequence = frame.Sequence;
+        _lastAccepted = now;
+        _lastIssued = frame.IssuedAt;
+        return true;
+    }
+
+    private static bool Vector(float[]? value, float bound) => value is { Length: 3 }
+        && value.All(v => float.IsFinite(v) && MathF.Abs(v) <= bound);
+}
