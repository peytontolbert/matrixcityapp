@@ -0,0 +1,38 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace AssettoServer.Server;
+
+// Website account authorization supplements, and never replaces, Steam auth.
+public sealed class MatrixNativeAdmission(string room, string key)
+{
+    public static MatrixNativeAdmission? Current { get; set; }
+    private readonly object _gate = new();
+    private readonly Dictionary<string,long> _used = new();
+    private readonly HashSet<string> _actors = new();
+    private static string Url(byte[] data) => Convert.ToBase64String(data).TrimEnd('=').Replace('+','-').Replace('/','_');
+    public bool Accept(ulong steam, string model, string password, long now, out string? actor)
+    {
+        actor=null;
+        if(model!="06_ygt_53_nissan_350z" || password.Length>240)return false;
+        var parts=password.Split('.');
+        if(parts.Length!=3||parts[0]!="mg1"||!Regex.IsMatch(parts[1],"^[A-Za-z0-9_-]+$")||!Regex.IsMatch(parts[2],"^[A-Za-z0-9_-]{43}$"))return false;
+        var expected=Url(HMACSHA256.HashData(Encoding.UTF8.GetBytes(key),Encoding.UTF8.GetBytes(room+"|"+parts[1])));
+        if(!CryptographicOperations.FixedTimeEquals(Encoding.ASCII.GetBytes(expected),Encoding.ASCII.GetBytes(parts[2])))return false;
+        string[] values;
+        try { var p=parts[1].Replace('-','+').Replace('_','/');p=p.PadRight((p.Length+3)/4*4,'=');values=Encoding.UTF8.GetString(Convert.FromBase64String(p)).Split('|'); }
+        catch(FormatException){return false;}
+        if(values.Length!=4||!Guid.TryParseExact(values[0],"D",out _)||values[1]!=steam.ToString()
+           ||!long.TryParse(values[2],out var expires)||expires<=now||expires>now+95||!Regex.IsMatch(values[3],"^[A-Za-z0-9_-]{16}$"))return false;
+        lock(_gate){
+            foreach(var id in _used.Where(v=>v.Value<=now).Select(v=>v.Key).ToArray())_used.Remove(id);
+            if(_used.Count>=4096||_used.ContainsKey(values[3])||_actors.Contains(values[0]))return false;
+            _used.Add(values[3],expires);_actors.Add(values[0]);actor=values[0];return true;
+        }
+    }
+    public void Release(string? actor){if(actor!=null)lock(_gate)_actors.Remove(actor);}
+}
